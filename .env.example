# Copiá este archivo como .env y completá los valores.
# El .env no se sube al repositorio (está en .gitignore).

# Supabase · Project Settings → API Keys
# Estas dos son públicas: van dentro del código que corre en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase · Project Settings → API Keys → service_role
# ESTA ES LA MÁS PELIGROSA DE TODAS: saltea RLS por completo, en todos los
# comercios. Solo la usa la función de api/usuarios.js, del lado del servidor,
# para dar de alta usuarios en Auth. Nunca en el navegador, nunca en un script
# que se comparta. Sin ella el sistema funciona igual: lo único que no se puede
# es crear accesos desde la pantalla.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase · botón Connect → Session pooler
# Esta SÍ es secreta: da acceso total a la base. Solo la usan los scripts
# de scripts/, nunca el navegador.
SUPABASE_DB_URL=

# Anthropic · solo para desarrollo local.
# En producción la usa la función de api/anthropic.js desde Vercel.
ANTHROPIC_API_KEY=

# Mercado Pago: ya no va acá. Cada comercio conecta su cuenta desde Ajustes →
# Mercado Pago (0091), y el token se guarda cifrado con ARCA_CLAVE_MAESTRA.

# ARCA (factura electrónica) · la cuenta de Genez en Afip SDK (app.afipsdk.com).
# Con esto solo se factura en homologación, con el CUIT de pruebas: sin
# validez fiscal. Lo usan api/arca/facturar.js y scripts/probar-arca.mjs.
# El CUIT y el punto de venta de cada comercio no van acá: están en la
# tabla arca_conexiones (migración 0082).
AFIP_ACCESS_TOKEN=

# ARCA · cifra las claves privadas de los certificados de cada comercio
# (api/arca/_cifrado.js). 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tiene que ser LA MISMA en el .env local y en Vercel (production y preview):
# la base es una sola, y una clave cifrada con otra llave no se abre.
# Perderla obliga a cada comercio a pedir un certificado nuevo.
ARCA_CLAVE_MAESTRA=

# La tarea diaria del CAEA (api/arca/caea.js, vercel.json → crons). Vercel
# la manda como "Authorization: Bearer <esto>" y sin ella la tarea no corre.
# Solo en Vercel (production); en local no hace falta. Cualquier texto largo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Los mails de la prueba gratis (0127): api/_pruebas.js, desde el cron de
# founder.js. Solo en Vercel. Sin la clave no se manda nada y no se rompe nada.
# RESEND_FROM tiene que ser de un dominio verificado en Resend; SITIO_URL es a
# dónde lleva el botón "Entrar" del mail.
RESEND_API_KEY=

# Abre el registro con cuenta propia y prueba de 10 días (0127). Sin esto,
# "Probalo gratis" deja una solicitud y Genez activa a mano. Prenderlo en
# Vercel recién con Resend como SMTP de Supabase Auth y los términos
# publicados; viaja al navegador (VITE_) y necesita volver a publicar.
VITE_ALTAS_ABIERTAS=
RESEND_FROM=Genez <hola@genez.com.ar>
SITIO_URL=https://genez.com.ar

# WhatsApp de Genez (Founder, 0120): api/founder.js. Solo en Vercel; en local
# no hacen falta salvo para probar contra Meta. Nunca en el navegador (sin VITE_).
# El token permanente del usuario del sistema de Meta (Business Settings →
# Usuarios del sistema), con permisos whatsapp_business_messaging y
# whatsapp_business_management.
WHATSAPP_TOKEN=
# La clave secreta de la app (Meta → la app → Configuración → Básica). Firma
# cada webhook: sin ella, api/founder.js contesta 503 y Meta reintenta.
WHATSAPP_APP_SECRET=
# La inventás vos; se pega igual acá y en Meta → WhatsApp → Configuración → Webhook.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=
# El PIN de 6 dígitos de la verificación en dos pasos del número. Solo para
# registrarlo en la API (Configuración → WhatsApp → Registrar el número).
WHATSAPP_PIN=
